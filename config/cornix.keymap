#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// Homerow Mods の設定
#define HM_TAPPING_TERM 250
#define HM_TAPPING_TERM_SHIFT 200

// レイヤー定義
#define BASE 0
#define SYM 1
#define NAV 2
#define SHORT 3
#define WINDOW 4
#define SCROLL 5
#define SETTING 6

// キー位置の定義（Homerow Mods 用）
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // 左手
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // 右手
#define THUMBS LH1 LH0 RH0 RH1

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

// マウススクロールの挙動調整（加速なし、即反応）
&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

/ {
    macros {
        // ・（中黒）入力: LANG1 → / → Enter
        nakaguro: nakaguro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &kp FSLH &kp ENTER>;
        };

        // suiei1213 入力
        macro_suiei: macro_suiei {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp U &kp I &kp E &kp I &kp N1 &kp N2 &kp N1 &kp N3>;
        };

        // Cmd+上スクロール（押している間続く）: ピンチイン（ズームイン）
        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &msc SCRL_DOWN>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_DOWN &kp LGUI>;
        };

        // レイヤー有効化 + Ctrl/Option 押しっぱなし（押している間続く）
        // パラメータ = 有効化するレイヤー番号
        // Axis 側で「Ctrl+Option 長押し」を検知させるため、レイヤー中は実際に修飾キーを送り続ける
        layer_ctrl_alt: layer_ctrl_alt {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_press &kp LCTRL &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT &kp LCTRL>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>;
        };

        // レイヤー有効化 + 入った瞬間に Triggerkey のトリガー（⇧⌃⌥⌘Space）を1回送り、
        // 離した瞬間に終了の合図（⇧⌃⌥⌘Esc）を送る
        // パラメータ = 有効化するレイヤー番号
        // レイヤー中のキーは素の英字なので、そのままコマンド（ogh など）を打てる。
        // 離すまで Triggerkey 側がセッションを閉じないため、押しっぱなしのまま
        // y（コピー）→ pp（ペースト）のように続けて打てる。
        layer_tk: layer_tk {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_tap &kp LS(LC(LA(LG(SPACE))))>
                , <&macro_pause_for_release>
                , <&macro_tap &kp LS(LC(LA(LG(ESC))))>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>;
        };

        // Cmd+下スクロール（押している間続く）: ピンチアウト（ズームアウト）
        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &msc SCRL_UP>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_UP &kp LGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // M, → ・
        combo_nakaguro {
            timeout-ms = <50>;
            key-positions = <33 34>;  // M, ,
            bindings = <&nakaguro>;
            layers = <BASE SYM NAV SHORT SCROLL SETTING>;  // WINDOW では無効
        };

        // DF → 左クリック
        combo_lclick {
            timeout-ms = <50>;
            key-positions = <15 16>;  // D, F
            bindings = <&mkp LCLK>;
            layers = <BASE SYM NAV>;
        };

        // DS → 右クリック
        combo_rclick {
            timeout-ms = <50>;
            key-positions = <14 15>;  // S, D
            bindings = <&mkp RCLK>;
            layers = <BASE SYM NAV>;
        };

        // JK → 左クリック
        combo_lclick_r {
            timeout-ms = <50>;
            key-positions = <19 20>;  // J, K
            bindings = <&mkp LCLK>;
            layers = <BASE SYM NAV>;
        };

        // KL → 右クリック
        combo_rclick_r {
            timeout-ms = <50>;
            key-positions = <20 21>;  // K, L
            bindings = <&mkp RCLK>;
            layers = <BASE SYM NAV>;
        };

        // SDFKJL → suiei1213
        combo_suiei {
            timeout-ms = <50>;
            key-positions = <14 15 16 19 20 21>;  // S, D, F, J, K, L
            bindings = <&macro_suiei>;
            layers = <BASE>;
        };

        // FS → F15
        combo_f15_l {
            timeout-ms = <50>;
            key-positions = <14 16>;  // S, F
            bindings = <&kp F15>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW, SHORT では無効
        };

        // JL → F15
        combo_f15_r {
            timeout-ms = <50>;
            key-positions = <19 21>;  // J, L
            bindings = <&kp F15>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW, SHORT では無効
        };

        // FDS → F16
        combo_f16_l {
            timeout-ms = <50>;
            key-positions = <14 15 16>;  // S, D, F
            bindings = <&kp F16>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW, SHORT では無効
        };

        // JKL → F16
        combo_f16_r {
            timeout-ms = <50>;
            key-positions = <19 20 21>;  // J, K, L
            bindings = <&kp F16>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW, SHORT では無効
        };

        // FA → F17
        combo_f17_l {
            timeout-ms = <50>;
            key-positions = <13 16>;  // A, F
            bindings = <&kp F17>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW, SHORT では無効
        };

        // J- → F17
        combo_f17_r {
            timeout-ms = <50>;
            key-positions = <19 22>;  // J, -
            bindings = <&kp F17>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW, SHORT では無効
        };

        // LANG2+LANG1 ホールド → Setting レイヤー（押しているときのみ有効）
        combo_setting_hold {
            timeout-ms = <50>;
            key-positions = <42 45>;  // LANG2(LH1), LANG1(RH1)
            bindings = <&mo SETTING>;
            layers = <BASE SYM NAV SHORT SCROLL SETTING>;  // WINDOW では無効
        };

    };

    behaviors {
        // 左手用 Homerow Mods（Ctrl, Option, Cmd）
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // 左手 Shift 専用 Homerow Mods（tapping-term 短め）
        hm_l_shift: homerow_mods_left_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM_SHIFT>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // 右手用 Homerow Mods（Cmd, Option, Ctrl）
        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // 右ホーム外側キー用（タップ: |/Shiftで_, ホールド: RALT）
        hm_r_ralt_pipe: homerow_mods_right_ralt_pipe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mm_pipe>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // 右ホーム外側キー用（タップ: -/Shiftで~, ホールド: Shift）
        hm_r_shift: homerow_mods_right_shift_minus {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mm_minus>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM_SHIFT>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // Ctrl/Option 付きレイヤータップ（&lt の代わり）
        // タップ: 第2引数のキー / ホールド: レイヤー有効化 + Ctrl+Option 押しっぱなし
        // flavor と tapping-term は ZMK 標準の &lt と同じ（tap-preferred / 200ms）にして
        // タップ時の入力の出やすさを &lt から変えない
        lt_ctrl_alt: layer_tap_ctrl_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&layer_ctrl_alt>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        // Triggerkey 付きレイヤータップ（&lt の代わり）
        // タップ: 第2引数のキー / ホールド: レイヤー有効化 + トリガーを1回送る
        // flavor は hold-preferred。tap-preferred だと tapping-term を待ち切るまでホールドと確定せず、
        // トリガー送出が毎回 200ms 遅れるうえ、待ち時間内に次のキーを打つとタップ側（TAB）に倒れるため。
        // hold-preferred は次のキーが押された瞬間にホールドが確定するので待ち時間が出ない。
        lt_tk: layer_tap_tk {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&layer_tk>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };

        // Nav用 hold-tap（タップで移動、ホールドで選択）
        ht_nav: hold_tap_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // mod-morph: ' → Shift: "
        mm_quot: mod_morph_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: # → Shift: *
        mm_hash: mod_morph_hash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp ASTRK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: $ → Shift: %
        mm_dllr: mod_morph_dollar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DLLR>, <&kp PRCNT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: \ → Shift: `
        mm_bslh: mod_morph_backslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: < → Shift: >
        mm_lt: mod_morph_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: ( → Shift: )
        mm_lpar: mod_morph_lpar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp RPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: [ → Shift: ]
        mm_lbkt: mod_morph_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: { → Shift: }
        mm_lbrc: mod_morph_lbrc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&kp RBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: | → Shift: _
        mm_pipe: mod_morph_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PIPE>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: : → Shift: ;
        mm_colon: mod_morph_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: = → Shift: ~
        mm_equal: mod_morph_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: = → Shift: _
        mm_equal_under: mod_morph_equal_under {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: - → Shift: ~
        mm_minus: mod_morph_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: ? → Shift: !
        mm_question: mod_morph_question {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(FSLH)>, <&kp LS(N1)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: + → Shift: ^
        mm_plus: mod_morph_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp CARET>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: Backspace → Shift: Delete
        mm_bspc: mod_morph_bspc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: Cmd+Tab → Shift: Option+Tab (window layer)
        mm_window_tab: mod_morph_window_tab {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(TAB)>, <&kp LA(TAB)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: Cmd+- → Shift: Option+Cmd+- (ズームアウト)
        mm_short_minus: mod_morph_short_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(MINUS)>, <&kp LA(LG(MINUS))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: Cmd++ → Shift: Option+Cmd+= (ズームイン)
        mm_short_plus: mod_morph_short_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(PLUS)>, <&kp LA(LG(EQUAL))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };


        // ショートカットレイヤー D位置: Shift時のhold-tap
        // タップ→Cmd+Shift+Opt+V、ホールド→Cmd+Ctrl+V
        ht_d_shift: hold_tap_d_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // D位置 mod-morph: 通常→Cmd+V/Cmd+Shift+V、Shift→Cmd+Shift+Opt+V/Cmd+Ctrl+V
        mm_short_d: mod_morph_short_d {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ht_nav LG(LS(V)) LG(V)>, <&ht_d_shift LC(LG(V)) LG(LS(LA(V)))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ショートカットレイヤー F位置: Shift時のhold-tap
        // タップ→Cmd+Shift+C、ホールド→Cmd+Shift+2
        ht_f_shift: hold_tap_f_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // F位置 mod-morph: 通常→Cmd+C/Cmd+Shift+4、Shift→Cmd+Shift+C/Cmd+Shift+2
        mm_short_f: mod_morph_short_f {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ht_nav LG(LS(N4)) LG(C)>, <&ht_f_shift LG(LS(N2)) LG(LS(C))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // --- スクロールレイヤー用 mod-morph ---

        // E: Scroll Up (Natural: Down signal) / Shift: Top (Cmd+Up)
        mm_scrl_e: mod_morph_scroll_e {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&kp LG(UP)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // D: Scroll Down (Natural: Up signal) / Shift: Bottom (Cmd+Down)
        mm_scrl_d: mod_morph_scroll_d {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&kp LG(DOWN)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // S: Scroll Left (Natural: Right signal) / Shift: Line Start (Cmd+Left)
        mm_scrl_s: mod_morph_scroll_s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&kp LG(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // F: Scroll Right (Natural: Left signal) / Shift: Line End (Cmd+Right)
        mm_scrl_f: mod_morph_scroll_f {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&kp LG(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // まーや用 QWERTY + Homerow Mods
            // ------------------------------------------------------------------------------------------
            // | none |  Q  |  W  |  E  |  R  |  T  |           |  Y  |  U  |  I  |  O  |  P  | none |
            // | none | A/⇧ | S/⌥ | D/⌘ | F/⌃ |  G  |           |  H  | J/⌃ | K/⌘ | L/⌥ |-/⇧ | none |
            // | none |  Z  |  X  |  C  |  V  |  B  |     |     |  N  |  M  |  、 |  。 | ?/! | none |
            //             | TAB |LANG2| SPC |           | ENT |LANG1| BKSP|

            bindings = <
&none     &kp Q            &kp W            &kp E            &kp R  &kp T                    &kp Y      &kp U          &kp I            &kp O            &kp P                &none
&none     &hm_l_shift LSHFT A    &hm_l LALT S     &hm_l LGUI D     &hm_l LCTRL F  &kp G          &kp H      &hm_r RCTRL J  &hm_r RGUI K     &hm_r RALT L     &hm_r_shift RSHFT MINUS  &none
&none     &kp Z            &kp X            &kp C            &kp V  &kp B      &kp C_MUTE  &kp F13  &kp N      &kp M          &kp COMMA        &kp PERIOD       &mm_question         &none
&none     &none            &none            &lt_tk SHORT TAB &lt SYM LANG2  &lt SCROLL SPACE          &lt_ctrl_alt WINDOW ENTER  &lt NAV LANG1  &mm_bspc       &none          &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        symbol_layer {
            display-name = "Symbol";

            // 記号レイヤー
            // ------------------------------------------------------------------------------------------
            // |  ¥  | '/" | #/* | $/% | \/` |           | </>  | (/)  | [/]  | {/}  | =/_ | --- |
            // | --- |  5  |  4  |  3  |  2  |  1  |           |  6  |  7  |  8  |  9  | --- | --- |
            // |  |  |  @  | --- |  :  |  &  |  @  | --- |  /  | --- |  0  |  ,  | --- | +/^ | --- |
            //             |Cmd+SPC| [L] | --- |           | --- | --- | --- |

            bindings = <
&trans    &kp LA(Y)        &mm_quot         &mm_hash         &mm_dllr  &mm_bslh               &mm_lt     &mm_lpar  &mm_lbkt       &mm_lbrc         &mm_equal_under      &trans
&trans    &hm_l_shift LSHFT N5   &hm_l LALT N4    &hm_l LGUI N3    &hm_l LCTRL N2  &kp N1           &kp N6     &hm_r RCTRL N7  &hm_r RGUI N8    &hm_r RALT N9        &hm_r_shift RSHFT MINUS  &trans
&trans    &kp PIPE         &kp AT           &mm_colon        &kp AMPS  &kp AT     &trans &trans &kp FSLH     &kp N0  &trans         &trans           &mm_plus             &trans
&trans    &trans           &trans           &kp LG(SPACE)    &trans  &trans                   &trans     &trans  &trans           &trans           &trans               &trans
            >;
        };

        nav_layer {
            display-name = "Nav";

            // カーソルレイヤー
            // ------------------------------------------------------------------------------------------
            // | --- | --- | --- | --- | --- | --- |           | --- |Cmd↑ |  ↑  |Cmd↓ | --- | --- |
            // | --- | --- | --- | --- | --- | --- |           |  ←  |  ↓  |  →  | --- | --- | --- |
            // | --- | --- | --- | --- | --- | --- |     |     | --- | --- | --- | --- | --- | --- |
            //             | --- | --- | --- |           | --- | [L] | --- |

            bindings = <
&trans    &trans           &trans           &trans           &trans  &trans                   &trans     &kp LG(UP)  &kp UP       &kp LG(DOWN)     &trans               &trans
&trans    &trans           &trans           &trans           &trans  &trans                   &ht_nav LG(LS(LEFT)) LG(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &ht_nav LG(LS(RIGHT)) LG(RIGHT)  &trans
&trans    &trans           &trans           &trans           &trans  &trans     &trans &trans &trans     &trans      &trans       &trans           &trans               &trans
&trans    &trans           &trans           &trans           &trans  &trans                   &trans     &trans      &kp ESC      &trans           &trans               &trans
            >;
        };

        shortcut_layer {
            display-name = "Shortcut";

            // ショートカットレイヤー（Triggerkey 専用）
            // レイヤーキー（&lt_tk）をホールドした瞬間にトリガー(⇧⌃⌥⌘Space)が1回飛ぶ。
            // このレイヤーの英字は素の &kp なので、ホームロー Mods もコンボも効かない。
            // 押しっぱなしのまま ogh などのコマンドを打って離す。
            // ------------------------------------------------------------------------------------------
            // | --- |  Q  |  W  |  E  |  R  |  T  |           |  Y  |  U  |  I  |  O  |  P  | --- |
            // | --- |  A  |  S  |  D  |  F  |  G  |           |  H  |  J  |  K  |  L  | --- | --- |
            // | --- |  Z  |  X  |  C  |  V  |  B  | --- | --- |  N  |  M  | --- | --- | --- | --- |
            //             | [L] | --- | --- |           |⌘+RET| --- | --- |

            bindings = <
&trans    &kp Q            &kp W            &kp E            &kp R   &kp T                    &kp Y           &kp U   &kp I        &kp O            &kp P                &trans
&trans    &kp A            &kp S            &kp D            &kp F   &kp G                    &kp H           &kp J   &kp K        &kp L            &trans               &trans
&trans    &kp Z            &kp X            &kp C            &kp V   &kp B   &trans &trans    &kp N           &kp M   &trans       &trans           &trans               &trans
&trans    &trans           &trans           &trans           &trans  &trans                   &kp LG(ENTER)   &trans  &trans       &trans           &trans               &trans
            >;
        };

        window_layer {
            display-name = "Window";

            // ウィンドウ操作レイヤー（Ctrl+Alt + 英文字）
            // レイヤーキー長押し中は Ctrl+Option が押しっぱなしになるため、
            // 素通し（&trans）にすると下のレイヤーのキーに Ctrl+Option が乗ってしまう。
            // そのため未割り当てのキーは Ctrl+Alt+文字 を明示し、親指キーは &none で無効化する。
            // ------------------------------------------------------------------------------------------
            // | --- |C+A+Q|C+A+W|C+A+E|C+A+R|C+A+T|           |C+A+Y|C+A+U|C+A+I|C+A+O|C+A+P| --- |
            // | --- |C+A+A|C+A+S/⌥|C+A+D/⌘|C+A+F/⌃|C+A+G|     |C+A+H|C+A+J/⌃|C+A+K/⌘|C+A+L/⌥|C+A+-/⇧| --- |
            // | --- |C+A+Z|C+A+X|C+A+C|C+A+V|C+A+B| --- | --- |C+A+N|C+A+M|C+A+, |C+A+. |C+A+S+=| --- |
            //             |無効 |無効 |無効 |           | [L] |無効 |無効 |

            bindings = <
&trans    &kp LC(LA(Q))    &kp LC(LA(W))    &kp LC(LA(E))              &kp LC(LA(R))            &kp LC(LA(T))            &kp LC(LA(Y))       &kp LC(LA(U))       &kp LC(LA(I))   &kp LC(LA(O))        &kp LC(LA(P))        &trans
&trans    &kp LC(LA(A))    &hm_l LALT LC(LA(S))    &hm_l LGUI LC(LA(D))    &hm_l LCTRL LC(LA(F))   &kp LC(LA(G))            &kp LC(LA(H))       &hm_r RCTRL LC(LA(J))    &hm_r RGUI LC(LA(K))   &hm_r RALT LC(LA(L))    &hm_r RSHFT LC(LA(MINUS))    &trans
&trans    &kp LC(LA(Z))    &kp LC(LA(X))    &kp LC(LA(C))              &kp LC(LA(V))            &kp LC(LA(B))  &trans &trans &kp LC(LA(N))   &kp LC(LA(M))       &kp LC(LA(COMMA)) &kp LC(LA(PERIOD))   &kp LC(LA(LS(EQUAL))) &trans
&trans    &trans           &trans           &none                      &none                    &none                    &trans              &none               &none           &trans               &trans               &trans
            >;
        };

        scroll_layer {
            display-name = "Scroll";

            // スクロールレイヤー
            // ------------------------------------------------------------------------------------------
            // | --- | --- | --- |  E↑ | --- | --- |           | --- | --- |Iズーム+| --- | --- | --- |
            // | --- | --- | S←  |  D↓ | F→  | --- |           | --- | --- |Kズーム-| --- | --- | --- |
            // | --- | --- | --- | --- | --- | --- |     |     | --- | --- | --- | --- | --- | --- |
            //             | --- | --- | [L] |           | --- | --- | --- |

            bindings = <
&trans    &trans           &trans           &mm_scrl_e       &trans  &trans                   &trans     &trans  &zoom_in     &trans           &trans               &trans
&trans    &trans           &mm_scrl_s       &mm_scrl_d       &mm_scrl_f       &trans          &trans     &trans  &zoom_out    &trans           &trans               &trans
&trans    &trans           &trans           &trans           &trans  &trans     &trans &trans &trans     &trans  &trans       &trans           &trans               &trans
&trans    &trans           &trans           &trans           &trans  &trans                   &trans     &trans  &trans       &trans           &trans               &trans
            >;
        };

        setting_layer {
            display-name = "Setting";

            // 設定レイヤー（LANG2+LANG1 同時押しでトグル）
            // ------------------------------------------------------------------------------------------
            // | --- | --- | --- | --- | BT.R | --- |           | --- | BT.2| --- | BT.1| --- |
            // | --- | --- | --- | --- | --- | --- |           | --- | --- | --- | --- | --- |
            // | --- | --- | --- | --- | --- | --- |     |     | --- | BT.0| --- | --- | --- | --- |
            //             | --- | --- | --- |           | --- | --- | --- |

            bindings = <
&trans    &trans           &trans           &trans           &bt BT_CLR  &trans               &trans     &trans  &bt BT_SEL 2 &trans           &bt BT_SEL 1         &trans
&trans    &trans           &trans           &trans           &trans  &trans                   &trans     &trans  &trans       &trans           &trans               &trans
&trans    &trans           &trans           &trans           &trans  &trans  &trans &trans    &trans     &bt BT_SEL 0  &trans             &trans           &trans               &trans
&trans    &trans           &trans           &trans           &trans  &trans                   &trans     &trans  &trans       &trans           &trans               &trans
            >;
        };
    };
};
